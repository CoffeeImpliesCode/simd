# `.zig-cache` is a symlink to a shared cache outside this work tree, so the
# pattern must not carry a trailing slash: a trailing slash matches a directory
# only, and would not match the symlink.
.zig-cache
zig-out/
zig-pkg/
.zig-global-cache/
__pycache__/
*.pyc
.ruff_cache/
result*
*.o
core
core.*
codedb.snapshot

# Devenv
.devenv/

# direnv
.direnv

# Jujutsu working copy state, including the colocated repository store.
.jj/

# Local pack-up notes; never published.
LOCAL_PACKUP_TODO.md
